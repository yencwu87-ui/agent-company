{"dur":65,"ev":[{"t":0.6,"type":"vo","id":"v1","text":"Putting an AI agent to work still feels like trial and error."},{"t":3.75,"type":"fall"},{"t":5.4,"type":"vo","id":"v2","text":"Work goes missing, and nobody can show what was done."},{"t":8.75,"type":"fall"},{"t":10,"type":"drop","note":62,"what":"depot","size":3},{"t":10.5,"type":"vo","id":"v3","text":"Agent Company gives the work a line, with six stations."},{"t":11.25,"type":"lamp","note":69,"what":"depot"},{"t":12.5,"type":"drop","note":66,"what":"house","size":1},{"t":13.75,"type":"drop","note":69,"what":"house","size":1},{"t":14.2,"type":"vo","id":"v4","text":"First a project. Then a team, with one job each."},{"t":15,"type":"drop","note":71,"what":"house","size":1},{"t":16.25,"type":"lamp","note":71,"what":"team"},{"t":17.5,"type":"drop","note":62,"what":"forge","size":3},{"t":18.5,"type":"vo","id":"v5","text":"Then the harness: six limits, fitted with one click."},{"t":18.75,"type":"piece","note":62,"i":0},{"t":20,"type":"piece","note":64,"i":1},{"t":21.25,"type":"piece","note":66,"i":2},{"t":22.5,"type":"piece","note":69,"i":3},{"t":23.75,"type":"piece","note":71,"i":4},{"t":25,"type":"tap"},{"t":25.3,"type":"vo","id":"v6","text":"Nothing skips ahead. A station opens only when the one before it is done."},{"t":25.625,"type":"buzz"},{"t":27.5,"type":"piece","note":74,"i":5},{"t":28.125,"type":"lamp","note":74,"what":"forge"},{"t":28.75,"type":"gate","note":74},{"t":30,"type":"tap"},{"t":32.5,"type":"drop","note":64,"what":"office","size":2},{"t":32.9,"type":"vo","id":"v7","text":"Written orders go in, and one coordinator starts the line."},{"t":33.75,"type":"order","note":69,"i":0},{"t":34.375,"type":"order","note":71,"i":1},{"t":35,"type":"order","note":74,"i":2},{"t":35.625,"type":"lamp","note":76,"what":"office"},{"t":35.625,"type":"order","note":76,"i":3},{"t":36.25,"type":"drop","note":62,"what":"floor","size":2},{"t":36.875,"type":"drop","note":66,"what":"floor","size":2},{"t":37.5,"type":"drop","note":69,"what":"floor","size":2},{"t":38.125,"type":"window","note":74,"i":0},{"t":38.75,"type":"window","note":76,"i":1},{"t":38.75,"type":"drop","note":59,"what":"vault","size":3},{"t":39.375,"type":"lamp","note":78,"what":"tower"},{"t":39.375,"type":"window","note":78,"i":2},{"t":40,"type":"run"},{"t":41.2,"type":"vo","id":"v8","text":"The screen shows only what is really in your repo."},{"t":41.25,"type":"replay","note":62,"i":0},{"t":42.5,"type":"replay","note":64,"i":1},{"t":43.125,"type":"pop","note":81},{"t":43.75,"type":"replay","note":66,"i":2},{"t":44.375,"type":"pop","note":78},{"t":45,"type":"replay","note":69,"i":3},{"t":45.625,"type":"pop","note":76},{"t":46.25,"type":"replay","note":71,"i":4},{"t":46.875,"type":"pop","note":81},{"t":47.5,"type":"replay","note":74,"i":5},{"t":48.125,"type":"pop","note":83},{"t":49.375,"type":"pop","note":86},{"t":50,"type":"seal","note":74},{"t":50.15,"type":"lamp","note":81,"what":"vault"},{"t":50.9,"type":"vo","id":"v9","text":"Then the proof is sealed. Merging stays with you."},{"t":55,"type":"title"}]}